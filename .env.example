# Développement uniquement. Compose fournit des paramètres PostgreSQL locaux par défaut.
PGUSER=
PGPASSWORD=
PGDATABASE=
PGPORT=
PGHOST=
# Obligatoire : générer une clé locale avec openssl rand -base64 48 (ne pas la versionner).
JWT_SECRET=
# Uniquement en production : voir .env.production.example.
SECRET_KEY_BASE=
DATABASE_URL=
PHX_HOST=
# Courriels locaux capturés par Mailpit ; aucun vrai envoi nécessaire.
MAILPIT_HOST=
MAILPIT_PORT=
RESEND_API_KEY=
RESEND_FROM=
RESEND_FROM_EMAIL=
# Facultatif : premier administrateur local.
ADMIN_EMAIL=
ADMIN_PASSWORD=
