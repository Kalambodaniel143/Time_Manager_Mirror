# Gotham City : adhésion et connexion au backend.
# Copier ces variables dans .env.local, puis redémarrer Vite.
VITE_AUTH_USE_MOCK=false
VITE_USE_MOCK=false
VITE_API_URL=/api
VITE_BACKEND_URL=http://localhost:4000

# Pour utiliser un backend distant en développement, renseigner son adresse
# dans VITE_BACKEND_URL. Le navigateur continue d’appeler /api sur Vite.
# Pour une démonstration locale explicite : npm run dev:demo.
