# Configuration réelle à préparer avec l'équipe ; aucune valeur ci-dessous n'est opérationnelle.
# Copier vers .env sur le serveur. Ne jamais versionner le fichier renseigné.
DOCKER_USERNAME=
# Obligatoire : SHA du commit testé, commun aux deux images publiées par la CI.
IMAGE_TAG=
PGUSER=
PGPASSWORD=
PGDATABASE=
# Format postgres://USER:PASSWORD@db:5432/DATABASE ; identifiants encodés en URL.
DATABASE_URL=
# Générer séparément deux clés avec openssl rand -base64 48.
JWT_SECRET=
SECRET_KEY_BASE=
# Nom d'hôte public, sans protocole ni chemin. Port HTTP par défaut : 80.
PHX_HOST=
PUBLIC_PORT=
# Fournisseur courriel : clé API et expéditeur vérifié ; Mailpit reste réservé aux tests.
RESEND_API_KEY=
RESEND_FROM=
# Facultatif : premier administrateur, initialisé par les seeds.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# CI uniquement : ne pas transmettre ces secrets aux conteneurs applicatifs.
DOCKER_PASSWORD=
SERVER_IP=
SERVER_USER=
SSH_KEY=
SSH_KNOWN_HOSTS=
# Publication et déploiement désactivés tant que ces autorisations restent vides.
PUBLISH_IMAGES=
DEPLOY_APPROVED=
